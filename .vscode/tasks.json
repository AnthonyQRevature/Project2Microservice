{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Docker Run Eureka Server",
			"type": "shell",
			"command": "docker-compose",
			"args": [
				"up",
				"--build"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Eureka Server",
			"type": "shell",
			"command": "C:/Program Files/Git/bin/bash.exe",
			"args": [
				"./mvnw",
				"spring-boot:run"
			],
			"options": {
				"cwd": "${workspaceFolder}/eureka-demo"
			},
			"problemMatcher": []
		},
		{
			"label": "Api Gateway",
			"type": "shell",
			"command": "C:/Program Files/Git/bin/bash.exe",
			"args": [
				"./mvnw",
				"spring-boot:run"
			],
			"options": {
				"cwd": "${workspaceFolder}/api-gateway-demo"
			},
			"problemMatcher": []
		},
		{
			"label": "Auth Server",
			"type": "shell",
			"command": "C:/Program Files/Git/bin/bash.exe",
			"args": [
				"./mvnw",
				"spring-boot:run"
			],
			"options": {
				"cwd": "${workspaceFolder}/auth-server"
			},
			"problemMatcher": []
		},
		{
			"label": "User Server",
			"type": "shell",
			"command": "C:/Program Files/Git/bin/bash.exe",
			"args": [
				"./mvnw",
				"spring-boot:run"
			],
			"options": {
				"cwd": "${workspaceFolder}/user-server"
			},
			"problemMatcher": []
		},
		{
			"label": "Install Util",
			"type": "process",
			"command": "mvn",
			"args": [
				"install"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}/util"
			}
		},
		{
			"label": "Docker Build Util",
			"type": "process",
			"command": "docker",
			"args": [
				"build",
				"-t",
				"util",
				"."
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}/util"
			}
		},
		{
			"label": "ssh jenkins server",
			"type": "shell",
			"command": "Start-Process",
			"args": [
				"-FilePath",
				"C:/WINDOWS/System32/cmd.exe",
				"-ArgumentList",
				"/K ssh ec2-user@ec2-3-138-173-15.us-east-2.compute.amazonaws.com"
			],
			"problemMatcher": []
		},
		{
			"label": "ssh application server",
			"type": "shell",
			"command": "Start-Process",
			"args": [
				"-FilePath",
				"C:/WINDOWS/System32/cmd.exe",
				"-ArgumentList",
				"/K ssh ec2-user@ec2-18-188-6-236.us-east-2.compute.amazonaws.com"
			],
			"problemMatcher": []
		}
	]
}